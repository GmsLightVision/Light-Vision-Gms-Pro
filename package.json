{
  "name": "light-vision-gms-pro",
  "version": "2.3.0",
  "description": "Plataforma Light Vision Gms Pro 2.3.0 - Casas de apostas integradas",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "ao.lightvision.gmspro",
    "productName": "Light Vision Gms Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "mobile.html",
      "manifest.json",
      "Gms.jpeg",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Light Vision Gms Pro"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "icon/icon.png",
      "identity": null
    }
  },
  "author": "Light Vision",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.18.0"
  }
}
